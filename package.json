{
    "name": "poker",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vp dev",
        "build": "vp build",
        "preview": "vp preview",
        "check": "vp check && svelte-check --tsconfig ./tsconfig.app.json && tsgo --noEmit -p tsconfig.node.json",
        "lint": "vp lint",
        "format": "vp fmt --write",
        "test": "vp test run",
        "test:e2e": "playwright test",
        "e2e:app": "VITE_TRACKER_URLS=ws://127.0.0.1:8000 vp dev --host 127.0.0.1 --port 4173",
        "e2e:tracker": "tsx node_modules/wt-tracker/src/run-tracker.ts e2e/tracker.config.json",
        "postinstall": "patch-package"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.18",
        "qrcode": "^1.5.4",
        "y-webtorrent": "github:woohp/y-webtorrent",
        "yjs": "^13.6.31"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@sveltejs/vite-plugin-svelte": "^6.2.1",
        "@tsconfig/svelte": "^5.0.6",
        "@types/node": "^24.10.1",
        "@types/qrcode": "^1.5.6",
        "@typescript/native-preview": "beta",
        "patch-package": "^8.0.1",
        "svelte": "^5.43.8",
        "svelte-check": "^4.3.4",
        "tailwindcss": "^4.1.18",
        "tsx": "^4.23.0",
        "typescript": "^6.0.3",
        "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.68.0",
        "vite": "npm:@voidzero-dev/vite-plus-core@latest",
        "vite-plus": "latest",
        "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
        "wt-tracker": "github:Novage/wt-tracker"
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@latest",
        "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
    },
    "packageManager": "npm@11.12.1"
}
